    },
    {
      "type": "text",
      "id": "spec_3_val",
      "label": "Spesifikasi 3 Nilai",
      "default": "135 Nm"
    },
    {
      "type": "text",
      "id": "spec_3_lbl",
      "label": "Spesifikasi 3 Label",
      "default": "Torsi Maksimum"
    },
    {
      "type": "text",
      "id": "spec_4_val",
      "label": "Spesifikasi 4 Nilai",
      "default": "4.9 s"
    },
    {
      "type": "text",
      "id": "spec_4_lbl",
      "label": "Spesifikasi 4 Label",
      "default": "0-50 km/h"
    },
    {
      "type": "text",
      "id": "s2_title",
      "label": "Section 2 Judul",
      "default": "Tampilan Cerah Berkat Desain Ocean Nan Estetik"
    },
    {
      "type": "textarea",
      "id": "s2_desc",
      "label": "Section 2 Deskripsi",
      "default": "Anggota terbaru seri Ocean yang merevolusi mobilitas perkotaan dengan desain dinamis dan teknologi inovatif."
    },
    {
      "type": "text",
      "id": "s3_title",
      "label": "Section 3 Judul",
      "default": "Saatnya Beralih ke Mobil Listrik"
    },
    {
      "type": "textarea",
      "id": "s3_desc",
      "label": "Section 3 Deskripsi",
      "default": "Temukan kebebasan mobilitas yang praktis dan sepenuhnya elektrik. Saatnya beralih ke gaya hidup ramah lingkungan bersama BYD Atto 1."
    },
    {
      "type": "text",
      "id": "s4_title",
      "label": "Section 4 Judul",
      "default": "Kendali Cerdas di Ujung Jari"
    },
    {
      "type": "textarea",
      "id": "s4_desc",
      "label": "Section 4 Deskripsi",
      "default": "Dashboard ergonomis dengan touch screen yang mendukung Apple CarPlay & Android Auto."
    },
    {
      "type": "text",
