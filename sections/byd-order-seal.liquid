  /* Larger price numbers */
  .price-val {
    font-size: 26px;
    line-height: 1;
    font-weight: 700;
    color: #000000;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    letter-spacing: -0.5px;
  }

  .price-asterisk {
    color: #2c6ecb;
    font-size: 20px;
    font-weight: 700;
