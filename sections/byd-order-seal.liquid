  .car-btns {
    width: 100%;
  }

  /* Larger button font and dimensions */
  .btn-selanjutnya {
    display: block;
    width: 100%;
    height: 48px;
    line-height: 46px;
    text-align: center;
    background-color: #ffffff;
    border: 1px solid #252728;
    color: #000000;
    font-size: 15.5px;
    font-weight: 600;
