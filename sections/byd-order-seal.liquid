    animation: modalFadeIn 0.25s ease;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .byd-lead-modal-box {
    background: #ffffff;
    color: #252728;
    width: 100%;
    max-width: 580px;
    border-radius: 6px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    position: relative;
    padding: 36px 36px 32px;
    max-height: 92vh;
    overflow-y: auto;
  }

  .modal-close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #70757a;
    cursor: pointer;
    padding: 6px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .modal-close-btn:hover {
    background: #f1f3f4;
    color: #000000;
  }

  .modal-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .modal-title {
    font-size: 20px;
    font-weight: 700;
    color: #252728;
    margin: 0 0 6px 0;
  }

  .modal-subtitle {
    font-size: 13px;
    color: #666e75;
    margin: 0;
    line-height: 1.4;
  }

  /* Spec summary badge */
  .modal-spec-summary {
    background-color: #f7f9fa;
    border: 1px solid #e5e8eb;
    border-radius: 4px;
    padding: 12px 16px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 22px;
  }

  .summary-item {
    font-size: 12px;
  }

  .summary-label {
    color: #70757a;
    display: block;
    margin-bottom: 2px;
  }

  .summary-item strong {
    color: #252728;
    font-size: 13px;
  }

  .summary-item .highlight-price {
    color: #2c6ecb;
    font-weight: 700;
  }

  /* Form Elements */
  .byd-lead-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-row {
    display: flex;
    gap: 14px;
  }

  .form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    color: #252728;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #dcdfe6;
    border-radius: 4px;
    font-size: 13px;
    color: #252728;
    background-color: #ffffff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #252728;
    box-shadow: 0 0 0 2px rgba(37, 39, 40, 0.1);
  }

  .form-privacy {
    margin-top: 4px;
  }

  .privacy-label {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11.5px;
    color: #666e75;
    line-height: 1.4;
    cursor: pointer;
  }

  .privacy-label input {
    margin-top: 2px;
  }

  .submit-lead-btn {
    width: 100%;
    height: 46px;
    background-color: #252728;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 6px;
    transition: background-color 0.2s;
  }

  .submit-lead-btn:hover {
    background-color: #000000;
  }

  /* Success State */
  .modal-success-state {
    text-align: center;
    padding: 30px 10px 10px;
    animation: fadeInDown 0.3s ease;
  }

  .success-icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #dcfce7;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .success-title {
    font-size: 18px;
    font-weight: 700;
    color: #252728;
    margin: 0 0 10px;
  }

  .success-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #555c65;
    max-width: 440px;
    margin: 0 auto 24px;
  }

  .btn-success-close {
    padding: 12px 36px;
    background-color: #252728;
    color: #ffffff;
    border: none;
    border-radius: 3px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .btn-success-close:hover {
    background-color: #000000;
  }

  /* ==========================================================
     RESPONSIVE BREAKPOINT RULES (AGENTS.md: 990px)
     ========================================================== */

  /* Desktop: above 990px */
  @media (min-width: 991px) {
    .byd-order-root {
      height: calc(100vh - 68px);
      margin-top: 68px;
    }

    .order-options-content {
      height: 100%;
    }

    .order-options-content-bg {
      width: calc(100% - 380px);
      height: 100%;
    }

    .from-content {
      height: 100%;
    }
  }

  /* Mobile / Tablet: 990px and below */
  @media (max-width: 990px) {
    .byd-order-root {
      margin-top: 64px;
      height: auto;
      overflow: visible;
    }

    .order-options-content {
      flex-direction: column;
      height: auto;
      min-height: auto;
      overflow: visible;
    }

    .order-options-content-bg {
      width: 100%;
      height: 65vw;
      min-height: 280px;
      max-height: 520px;
    }

    .from-content {
      width: 100%;
      height: auto;
      box-shadow: none;
    }

    .from-content-inner {
      padding: 32px 20px 40px;
    }

    .form-row {
      flex-direction: column;
      gap: 12px;
    }

    .byd-lead-modal-box {
      padding: 28px 20px 24px;
    }

    .modal-spec-summary {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    // Force zero body/main margin & dark background so no white gaps appear
    function enforceDarkFullBleed() {
      document.documentElement.style.backgroundColor = '#252728';
      document.body.style.backgroundColor = '#252728';
      document.body.style.margin = '0';
      document.body.style.padding = '0';

      var mainContent = document.getElementById('MainContent');
      if (mainContent) {
        mainContent.style.margin = '0';
        mainContent.style.padding = '0';
        mainContent.style.backgroundColor = '#252728';
      }

      // Hide footer section completely on desktop
      if (window.innerWidth > 990) {
        var footerSection = document.querySelector('.byd-section-footer, .shopify-section:has(.byd-footer), footer');
        if (footerSection) {
          var sec = footerSection.closest('.shopify-section') || footerSection;
          sec.style.display = 'none';
        }
      }
    }

    enforceDarkFullBleed();
    window.addEventListener('DOMContentLoaded', enforceDarkFullBleed);
    window.addEventListener('resize', enforceDarkFullBleed);

    // Current Active States
    let currentTab = 'warna'; // 'warna' | 'interior' | 'roda'
    let currentViewIndex = 0; // 0: exterior, 1: interior, 2: wheel
    let currentVersion = 'Premium Ext. Range';
    let currentPrice = '869,000,000';
    let currentColor = 'Atlantis Grey';

    // DOM Elements
    const viewPictures = [
      document.getElementById('viewExterior'),
      document.getElementById('viewInterior'),
      document.getElementById('viewWheel')
    ];

    const tabs = {
      warna: document.getElementById('tabWarna'),
      interior: document.getElementById('tabInterior'),
      roda: document.getElementById('tabRoda')
    };

    const panels = {
      warna: document.getElementById('listWarna'),
      interior: document.getElementById('listInterior'),
      roda: document.getElementById('listRoda')
    };

    const colorStateName = document.getElementById('colorStateName');
    const versionActiveBtn = document.getElementById('versionActiveBtn');
    const versionActiveLabel = document.getElementById('versionActiveLabel');
    const versionDropdown = document.getElementById('versionDropdown');
    const carPriceDisplay = document.getElementById('carPriceDisplay');

    // Switch View
    function setView(index) {
      currentViewIndex = (index + 3) % 3;
      viewPictures.forEach(function(pic, idx) {
        if (pic) {
          if (idx === currentViewIndex) {
            pic.classList.add('active');
          } else {
            pic.classList.remove('active');
          }
        }
      });

      // Synchronize Tab
      var tabKey = currentViewIndex === 0 ? 'warna' : (currentViewIndex === 1 ? 'interior' : 'roda');
      activateTab(tabKey, false);
    }

    // Activate Tab
    function activateTab(tabKey, updateView) {
      if (updateView === undefined) updateView = true;
      currentTab = tabKey;

      // Update Tab Buttons
      Object.keys(tabs).forEach(function(key) {
        if (tabs[key]) {
          if (key === tabKey) {
            tabs[key].classList.add('details-avive');
            tabs[key].setAttribute('aria-selected', 'true');
          } else {
            tabs[key].classList.remove('details-avive');
            tabs[key].setAttribute('aria-selected', 'false');
          }
        }
      });

      // Update Panels
      Object.keys(panels).forEach(function(key) {
        if (panels[key]) {
          if (key === tabKey) {
            panels[key].style.display = 'block';
            panels[key].classList.add('active');
          } else {
            panels[key].style.display = 'none';
            panels[key].classList.remove('active');
          }
        }
      });

      // If requested, sync car stage image
      if (updateView) {
        var viewIdx = tabKey === 'warna' ? 0 : (tabKey === 'interior' ? 1 : 2);
        currentViewIndex = viewIdx;
        viewPictures.forEach(function(pic, idx) {
          if (pic) {
            if (idx === currentViewIndex) {
              pic.classList.add('active');
            } else {
              pic.classList.remove('active');
            }
          }
        });
      }
    }

    // Attach Tab Clicks
    if (tabs.warna) tabs.warna.addEventListener('click', function() { activateTab('warna'); });
    if (tabs.interior) tabs.interior.addEventListener('click', function() { activateTab('interior'); });
    if (tabs.roda) tabs.roda.addEventListener('click', function() { activateTab('roda'); });

    // Navigation Chevrons
    var btnLeft = document.getElementById('btnNavLeft');
    var btnRight = document.getElementById('btnNavRight');
    if (btnLeft) btnLeft.addEventListener('click', function() { setView(currentViewIndex - 1); });
    if (btnRight) btnRight.addEventListener('click', function() { setView(currentViewIndex + 1); });

    // Swatches Selection
    var colorSwatches = document.querySelectorAll('#listWarna .car-info-list');
    colorSwatches.forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        colorSwatches.forEach(function(s) { s.classList.remove('active'); });
        swatch.classList.add('active');
        var color = swatch.getAttribute('data-color') || 'Atlantis Grey';
        currentColor = color;
        if (colorStateName) colorStateName.textContent = color;
        // ensure exterior view is shown
        setView(0);
      });
    });

    // Version Dropdown Toggle
    if (versionActiveBtn && versionDropdown) {
      versionActiveBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = versionDropdown.classList.contains('show');
        if (isOpen) {
          versionDropdown.classList.remove('show');
          versionActiveBtn.classList.remove('is-open');
        } else {
          versionDropdown.classList.add('show');
          versionActiveBtn.classList.add('is-open');
        }
      });

      document.addEventListener('click', function() {
        versionDropdown.classList.remove('show');
        versionActiveBtn.classList.remove('is-open');
      });

      var versionItems = versionDropdown.querySelectorAll('.version-dropdown-item');
      versionItems.forEach(function(item) {
        item.addEventListener('click', function(e) {
          e.stopPropagation();
          versionItems.forEach(function(v) { v.classList.remove('active'); });
          item.classList.add('active');

          var vName = item.getAttribute('data-version') || 'Premium Ext. Range';
          var vPrice = item.getAttribute('data-price') || '869,000,000';

          currentVersion = vName;
          currentPrice = vPrice;

          if (versionActiveLabel) versionActiveLabel.textContent = vName;
          if (carPriceDisplay) carPriceDisplay.textContent = vPrice;

          versionDropdown.classList.remove('show');
          versionActiveBtn.classList.remove('is-open');
        });
      });
    }

    // Modal Operations
    var leadOverlay = document.getElementById('leadModalOverlay');
    var btnOpen = document.getElementById('btnOpenLeadModal');
    var btnClose = document.getElementById('btnCloseModal');
    var btnSuccessClose = document.getElementById('btnSuccessClose');
    var leadForm = document.getElementById('bydLeadForm');
    var successState = document.getElementById('modalSuccessState');

    function openModal() {
      if (!leadOverlay) return;
      document.getElementById('modalSummaryModel').textContent = 'BYD SEAL';
      document.getElementById('modalSummaryVersion').textContent = currentVersion;
      document.getElementById('modalSummaryColor').textContent = currentColor;
      document.getElementById('modalSummaryPrice').textContent = 'Rp ' + currentPrice + '*';

      if (leadForm) leadForm.style.display = 'flex';
      if (successState) successState.style.display = 'none';

      leadOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!leadOverlay) return;
      leadOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (btnOpen) btnOpen.addEventListener('click', openModal);
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnSuccessClose) btnSuccessClose.addEventListener('click', closeModal);

    if (leadOverlay) {
      leadOverlay.addEventListener('click', function(e) {
        if (e.target === leadOverlay) {
          closeModal();
        }
      });
    }

    // Submit Lead function
    window.submitLead = function() {
      var submitBtn = document.getElementById('btnSubmitLead');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Memproses Permintaan...';
      }

      setTimeout(function() {
        if (leadForm) leadForm.style.display = 'none';
        if (successState) successState.style.display = 'block';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Kirim Permintaan Penawaran';
        }
      }, 700);
    };

  })();
</script>

