{% comment %}
  BYD SEAL - Dapatkan Penawaran / Vehicle Detail & Configurator Page
  First-pass implementation based on https://www.byd.com/id/order-seal
  Conforms to AGENTS.md: Montserrat font, 990px breakpoint, scoped CSS, Online Store 2.0.
{% endcomment %}

<div class="byd-order-root" id="bydOrderRoot">
  <div class="order-options-content">
    
    <!-- LEFT: Visual Car Studio Stage (~72% width) - Full height to bottom with centered car -->
    <div class="order-options-content-bg" id="orderCanvasStage">
      <div class="stage-viewports">
        <!-- View 1: Exterior (Active by default) -->
        <picture class="stage-picture active" id="viewExterior">
          <source media="(max-width: 990px)" srcset="{{ 'byd-order-seal-atlantis-grey.jpg' | asset_url }}">
          <img
            src="{{ 'byd-order-seal-atlantis-grey.jpg' | asset_url }}"
            alt="BYD SEAL Eksterior - Atlantis Grey"
            class="order-options-img"
            id="imgExterior"
            width="1440"
            height="900"
            loading="eager"
          >
        </picture>

        <!-- View 2: Interior -->
        <picture class="stage-picture" id="viewInterior">
          <source media="(max-width: 990px)" srcset="{{ 'byd-order-seal-interior.jpg' | asset_url }}">
          <img
            src="{{ 'byd-order-seal-interior.jpg' | asset_url }}"
            alt="BYD SEAL Interior Thaumas Black"
            class="order-options-img"
            width="1440"
            height="900"
            loading="lazy"
          >
        </picture>

        <!-- View 3: Wheel -->
        <picture class="stage-picture" id="viewWheel">
          <source media="(max-width: 990px)" srcset="{{ 'byd-order-seal-wheel-view.jpg' | asset_url }}">
          <img
            src="{{ 'byd-order-seal-wheel-view.jpg' | asset_url }}"
            alt="BYD SEAL 19 Inch Sport Alloy Wheel"
            class="order-options-img"
            width="1440"
            height="900"
            loading="lazy"
          >
        </picture>
      </div>

      <!-- Navigation Chevrons: Left (<) and Right (>) -->
      <div class="order-navigation">
        <button type="button" class="order-navigation-left" id="btnNavLeft" aria-label="Sudut sebelumnya">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="order-navigation-right" id="btnNavRight" aria-label="Sudut selanjutnya">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Bottom-Left Badge: 360 View Indicator -->
      <div class="stage-bottom-badge" title="Tampilan Interaktif BYD SEAL">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
        </svg>
      </div>
    </div>

    <!-- RIGHT: Configurator Options & Lead Panel (~28% width, pure white background) -->
    <div class="from-content">
      <div class="from-content-inner">
        
        <!-- Car Model Title -->
        <h1 class="car-title">{{ section.settings.model_title | default: 'BYD SEAL' }}</h1>

        <!-- Varian Selection Box -->
        <div class="car-version">
          <div class="version-active" id="versionActiveBtn" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false">
            <span id="versionActiveLabel">Premium Ext. Range</span>
            <svg class="version-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <!-- Dropdown options -->
          <div class="version-dropdown-menu" id="versionDropdown" role="listbox">
            <div class="version-dropdown-item active" data-version="Premium Ext. Range" data-price="869,000,000" role="option" aria-selected="true">
              <div class="v-info">
                <strong>Premium Ext. Range</strong>
                <small>650 km | 5.9s (0-100 km/h) | RWD</small>
              </div>
              <span class="v-price">Rp 869.000.000*</span>
            </div>
            <div class="version-dropdown-item" data-version="Performance AWD" data-price="969,000,000" role="option" aria-selected="false">
              <div class="v-info">
                <strong>Performance AWD</strong>
                <small>580 km | 3.8s (0-100 km/h) | Dual-Motor</small>
              </div>
              <span class="v-price">Rp 969.000.000*</span>
            </div>
          </div>
        </div>

        <!-- Main Configurator Section -->
        <div class="car-configure-main">
          <h2 class="car-configure">Siapkan BYD Anda</h2>

          <!-- Segmented Tab Controls: Warna | Interior | Roda -->
          <div class="car-configure-details" role="tablist">
            <button type="button" class="details-tab details-avive" data-tab="warna" role="tab" aria-selected="true" id="tabWarna">Warna</button>
            <button type="button" class="details-tab" data-tab="interior" role="tab" aria-selected="false" id="tabInterior">Interior</button>
            <button type="button" class="details-tab" data-tab="roda" role="tab" aria-selected="false" id="tabRoda">Roda</button>
          </div>

          <!-- TAB 1: Warna Eksterior -->
          <div class="car-configure-list active" id="listWarna" role="tabpanel" aria-labelledby="tabWarna">
            <h3 class="state-name" id="colorStateName">Atlantis Grey</h3>
            <div class="car-configure-icon">
              <!-- Swatch 1: Atlantis Grey -->
              <div class="car-info-list active" data-color="Atlantis Grey" data-img="{{ 'byd-order-seal-atlantis-grey.jpg' | asset_url }}" title="Atlantis Grey" role="button" tabindex="0">
                <div class="car-configure-list-active">
                  <div class="swatch-wrap">
                    <img src="{{ 'byd-order-swatch-grey.png' | asset_url }}" alt="Atlantis Grey" width="34" height="34">
                  </div>
                </div>
              </div>
              <!-- Swatch 2: Aurora White -->
              <div class="car-info-list" data-color="Aurora White" data-img="{{ 'byd-order-seal-atlantis-grey.jpg' | asset_url }}" title="Aurora White" role="button" tabindex="0">
                <div>
                  <div class="swatch-wrap swatch-white">
                    <img src="{{ 'byd-order-swatch-white.png' | asset_url }}" alt="Aurora White" width="34" height="34">
                  </div>
                </div>
              </div>
              <!-- Swatch 3: Cosmos Black -->
              <div class="car-info-list" data-color="Cosmos Black" data-img="{{ 'byd-order-seal-atlantis-grey.jpg' | asset_url }}" title="Cosmos Black" role="button" tabindex="0">
                <div>
                  <div class="swatch-wrap">
                    <img src="{{ 'byd-order-swatch-black.png' | asset_url }}" alt="Cosmos Black" width="34" height="34">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 2: Interior -->
          <div class="car-configure-list" id="listInterior" role="tabpanel" aria-labelledby="tabInterior" style="display: none;">
            <h3 class="state-name">Thaumas Black</h3>
            <div class="car-configure-icon">
              <div class="car-info-list active" data-interior="Thaumas Black" title="Thaumas Black" role="button" tabindex="0">
                <div class="car-configure-list-active">
                  <div class="swatch-wrap">
                    <img src="{{ 'byd-order-swatch-interior-black.png' | asset_url }}" alt="Thaumas Black" width="34" height="34">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 3: Roda -->
          <div class="car-configure-list" id="listRoda" role="tabpanel" aria-labelledby="tabRoda" style="display: none;">
            <h3 class="state-name">19 Inch Sport Alloy Wheels</h3>
            <div class="car-configure-icon">
              <div class="car-info-list active" data-wheel="19 Inch" title="19 Inch Sport Alloy Wheels" role="button" tabindex="0">
                <div class="car-configure-list-active">
                  <div class="swatch-wrap wheel-swatch">
                    <img src="{{ 'byd-order-seal-wheel.jpg' | asset_url }}" alt="19 Inch Sport Alloy Wheels" width="34" height="34">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Area: Price & CTA Selanjutnya -->
        <div class="car-operate">
          <div class="car-price is-show">
            <p class="price-desc">Harga Retail yang<br>disarankan</p>
            <h2 class="price-val">
              <span id="carPriceDisplay">869,000,000</span>
              <span class="price-asterisk">*</span>
            </h2>
          </div>
          
          <div class="car-btns">
            <button type="button" class="save btn-selanjutnya" id="btnOpenLeadModal">
              Selanjutnya
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Lead Generation / Penawaran Modal -->
  <div class="byd-lead-modal-overlay" id="leadModalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle" style="display: none;">
    <div class="byd-lead-modal-box">
      <button type="button" class="modal-close-btn" id="btnCloseModal" aria-label="Tutup Formulir">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="modal-header">
        <h3 class="modal-title" id="modalTitle">Dapatkan Penawaran Resmi</h3>
        <p class="modal-subtitle">Konfigurasi BYD SEAL Anda siap diajukan ke dealer resmi BYD Indonesia</p>
      </div>

      <!-- Selected Spec Badge -->
      <div class="modal-spec-summary">
        <div class="summary-item">
          <span class="summary-label">Model:</span>
          <strong id="modalSummaryModel">BYD SEAL</strong>
        </div>
        <div class="summary-item">
          <span class="summary-label">Varian:</span>
          <strong id="modalSummaryVersion">Premium Ext. Range</strong>
        </div>
        <div class="summary-item">
          <span class="summary-label">Warna:</span>
          <strong id="modalSummaryColor">Atlantis Grey</strong>
        </div>
        <div class="summary-item">
          <span class="summary-label">Estimasi OTR:</span>
          <strong class="highlight-price" id="modalSummaryPrice">Rp 869.000.000*</strong>
        </div>
      </div>

      <!-- Lead Generation Form -->
      <form class="byd-lead-form" id="bydLeadForm" onsubmit="event.preventDefault(); submitLead();">
        <div class="form-row">
          <div class="form-group">
            <label for="leadFullName">Nama Lengkap *</label>
            <input type="text" id="leadFullName" required placeholder="Contoh: Muhammad Raihan">
          </div>
          <div class="form-group">
            <label for="leadPhone">Nomor WhatsApp / HP *</label>
            <input type="tel" id="leadPhone" required placeholder="0812-xxxx-xxxx">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="leadEmail">Alamat Email *</label>
            <input type="email" id="leadEmail" required placeholder="nama@email.com">
          </div>
          <div class="form-group">
            <label for="leadCity">Kota / Dealer Terdekat *</label>
            <select id="leadCity" required>
              <option value="">-- Pilih Kota / Dealer --</option>
              <option value="Jakarta Selatan - Simatupang">Jakarta Selatan - BYD Simatupang</option>
              <option value="Jakarta Barat - Kebon Jeruk">Jakarta Barat - BYD Kebon Jeruk</option>
              <option value="Jakarta Utara - PIK">Jakarta Utara - BYD Pantai Indah Kapuk</option>
              <option value="Tangerang - BSD City">Tangerang - BYD BSD City</option>
              <option value="Bekasi - Summarecon">Bekasi - BYD Summarecon</option>
              <option value="Bandung - Soekarno Hatta">Bandung - BYD Soekarno Hatta</option>
              <option value="Surabaya - HR Muhammad">Surabaya - BYD HR Muhammad</option>
              <option value="Semarang - Pandanaran">Semarang - BYD Pandanaran</option>
              <option value="Medan - Gatot Subroto">Medan - BYD Gatot Subroto</option>
              <option value="Bali - Denpasar Bypass">Bali - BYD Denpasar Bypass</option>
              <option value="Makassar - Pettarani">Makassar - BYD Pettarani</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="leadPayment">Rencana Metode Pembelian</label>
          <select id="leadPayment">
            <option value="Tunai / Cash">Pembelian Tunai (Cash)</option>
            <option value="Kredit EV Ringan">Pembiayaan Kredit / Cicilan EV</option>
            <option value="Trade-In Mobil Lama">Tukar Tambah (Trade-In)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="leadNotes">Catatan Tambahan (Opsional)</label>
          <textarea id="leadNotes" rows="2" placeholder="Jadwal konsultasi yang diinginkan, simulasi kredit DP/tenor, dll."></textarea>
        </div>

        <div class="form-privacy">
          <label class="privacy-label">
            <input type="checkbox" required checked>
            <span>Saya menyetujui bahwa data saya dapat digunakan oleh PT BYD Motor Indonesia untuk keperluan penawaran dan penjadwalan konsultasi resmi.</span>
          </label>
        </div>

        <button type="submit" class="submit-lead-btn" id="btnSubmitLead">
          Kirim Permintaan Penawaran
        </button>
      </form>

      <!-- Success Feedback State -->
      <div class="modal-success-state" id="modalSuccessState" style="display: none;">
        <div class="success-icon-circle">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h4 class="success-title">Permintaan Penawaran Berhasil Dikirim!</h4>
        <p class="success-desc">
          Terima kasih. Konsultan resmi BYD Indonesia dari dealer terpilih akan segera menghubungi WhatsApp/Email Anda dengan rincian penawaran harga OTR, promo eksklusif, serta opsi simulasi cicilan BYD SEAL.
        </p>
        <button type="button" class="btn-success-close" id="btnSuccessClose">
          Selesai & Tutup
        </button>
      </div>

    </div>
  </div>
</div>

<style>
  /* ==========================================================
     BYD SEAL CONFIGURATOR & ORDER STYLES
     Font Stack: Montserrat, Arial, "Helvetica Neue", Helvetica, sans-serif
     Breakpoint: 990px (AGENTS.md project rule)
     ========================================================== */

  /* Global root overrides to prevent any white gap or margin */
  html, body {
    background-color: #252728 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  #MainContent {
    background-color: #252728 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  /* Scoped Page Overrides: Hide global footer & floating contact on desktop order configurator */
  .byd-floating-contact,
  .byd-section-floating-contact,
  .shopify-section:has(.byd-floating-whatsapp) {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  @media (min-width: 991px) {
    .byd-footer,
    .byd-section-footer,
    .shopify-section:has(.byd-footer),
    footer {
      display: none !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  }

  .byd-order-root {
    font-family: Montserrat, Arial, "Helvetica Neue", Helvetica, sans-serif !important;
    background-color: #252728;
    color: #252728;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .byd-order-root * {
    box-sizing: border-box;
    font-family: inherit;
  }

  /* Main Flex Container */
  .order-options-content {
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
    background-color: #252728;
  }

  /* ----------------------------------------------------
     LEFT: Car Studio Showcase (~72% - 75% width)
     Full viewport coverage with car lowered and centered vertically
     ---------------------------------------------------- */
  .order-options-content-bg {
    flex: 1;
    position: relative;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: #252728;
    background: radial-gradient(ellipse at 50% 50%, #404850 0%, #293037 60%, #1a2025 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-viewports {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .stage-picture {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease-in-out, visibility 0.4s ease-in-out;
  }

  .stage-picture.active {
    opacity: 1;
    visibility: visible;
  }

  /* Car image positioned perfectly in center / slightly lowered */
  .order-options-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%; /* lowered down to center comfortably */
    display: block;
    margin: 0;
    padding: 0;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Navigation Chevrons */
  .order-navigation {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    width: 100%;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 28px;
    pointer-events: none;
    z-index: 10;
  }

  .order-navigation-left,
  .order-navigation-right {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    border: none;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .order-navigation-left:hover,
  .order-navigation-right:hover {
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
    transform: scale(1.08);
  }

  /* Bottom-Left 360 Badge */
  .stage-bottom-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background-color 0.2s;
  }

  .stage-bottom-badge:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  /* ----------------------------------------------------
     RIGHT: Configurator Panel (~380px, pure white)
     ---------------------------------------------------- */
  .from-content {
    width: 380px;
    flex-shrink: 0;
    background-color: #ffffff;
    color: #252728;
    height: 100%;
    position: relative;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.08);
    overflow-y: auto;
    z-index: 20;
    margin: 0;
  }

  .from-content-inner {
    padding: 60px 36px 36px;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Title: BYD SEAL */
  .car-title {
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    text-align: center;
    letter-spacing: 0.8px;
    color: #000000;
    margin: 0 0 24px 0;
    text-transform: uppercase;
  }

  /* Version Box: Premium Ext. Range - spaced comfortably */
  .car-version {
    position: relative;
    width: 100%;
    margin-bottom: 72px; /* lowered down as in screenshot */
  }

  .version-active {
    background-color: #252728;
    color: #ffffff;
    height: 44px;
    border-radius: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
    user-select: none;
  }

  .version-active:hover {
    background-color: #1a1b1c;
  }

  .version-arrow {
    transition: transform 0.25s ease;
  }

  .version-active.is-open .version-arrow {
    transform: rotate(180deg);
  }

  /* Version Dropdown */
  .version-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    background: #ffffff;
    border: 1px solid #dcdfe6;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    display: none;
    z-index: 50;
    overflow: hidden;
  }

  .version-dropdown-menu.show {
    display: block;
    animation: fadeInDown 0.2s ease;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .version-dropdown-item {
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    border-bottom: 1px solid #f2f3f5;
    transition: background-color 0.15s;
  }

  .version-dropdown-item:last-child {
    border-bottom: none;
  }

  .version-dropdown-item:hover {
    background-color: #f7f8fa;
  }

  .version-dropdown-item.active {
    background-color: #f0f4ff;
    border-left: 3px solid #252728;
  }

  .version-dropdown-item .v-info strong {
    display: block;
    font-size: 13px;
    color: #252728;
  }

  .version-dropdown-item .v-info small {
    display: block;
    font-size: 11px;
    color: #70757a;
    margin-top: 2px;
  }

  .version-dropdown-item .v-price {
    font-size: 12.5px;
    font-weight: 600;
    color: #252728;
    white-space: nowrap;
  }

  /* Main Configurator Area */
  .car-configure-main {
    margin-bottom: auto;
  }

  /* Heading: Siapkan BYD Anda - lowered down with prominent size */
  .car-configure {
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    color: #000000;
    margin: 0 0 24px 0;
  }

  /* Segmented Tabs (Warna | Interior | Roda) */
  .car-configure-details {
    display: flex;
    width: 100%;
    border: 1px solid #252728;
    border-radius: 1px;
    overflow: hidden;
    height: 40px;
    margin-bottom: 24px;
  }

  .details-tab {
    flex: 1;
    height: 100%;
    border: none;
    background-color: #ffffff;
    color: #252728;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    border-right: 1px solid #252728;
    padding: 0;
  }

  .details-tab:last-child {
    border-right: none;
  }

  .details-tab.details-avive {
    background-color: #252728;
    color: #ffffff;
    font-weight: 600;
  }

  /* Active Color / Spec Name */
  .state-name {
    font-size: 14px;
    font-weight: 500;
    color: #252728;
    text-align: center;
    margin: 0 0 20px 0;
  }

  /* Swatches Row */
  .car-configure-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 28px;
    margin-bottom: 32px;
  }

  .car-info-list {
    position: relative;
    cursor: pointer;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .swatch-wrap {
    width: 34px;
    height: 34px;
    border-radius: 50%;
