  const groupedData = pricelistData.reduce((result, currentItem) => {
    const keyValue = currentItem.name;
    (result[keyValue] = result[keyValue] || []).push(currentItem);
    return result;
  }, {});

  const selectedSpecs = {
    'Byd Seal': 0,
    'Byd Atto 3': 0,
    'Byd Dolphin': 0,
    'Byd M6': 0,
    'BYD Sealion 7': 0,
    'BYD Atto 1': 0,
    'Byd M6 DM': 0
  };

  function renderSpecification(name, value) {
    if (!value || !name) return '';
    return `
      <div class="specification">
        <p class="specification-value">${value}</p>
        <p class="specification-name">${name}</p>
      </div>
    `;
  }

  function renderPricelist() {
    const container = document.getElementById('pricelist-container');
    if (!container) return;
    container.innerHTML = '';

    Object.entries(groupedData).forEach(([name, items]) => {
      const activeIndex = selectedSpecs[name] || 0;
      const selectedItem = items[activeIndex] || items[0];

      let acceleration = '';
      let accelerationNumber = '';
      if (selectedItem.specifications.zeroToHundred) {
        acceleration = '0-100 km/h';
        accelerationNumber = selectedItem.specifications.zeroToHundred;
      } else if (selectedItem.specifications.zeroToFifty) {
        acceleration = '0-50 km/h';
        accelerationNumber = selectedItem.specifications.zeroToFifty;
      }

      const itemHTML = `
        <div class="pricelist-item" data-car="${name}">
          <a class="pricelist-item-link" href="${selectedItem.link}">
            <div class="car-img-wrapper">
              <img class="car-img" src="${selectedItem.image}" alt="${name} - ${selectedItem.type}">
            </div>
            <div class="logo-img-wrapper">
              <img class="logo-img" src="${selectedItem.logoImage}" alt="${name}">
            </div>
          </a>
          <div class="specs-container">
            ${items.map((item, index) => `
              <div class="spec-button ${activeIndex === index ? 'active' : ''}" data-name="${name}" data-index="${index}">
                <span class="spec-type">${item.type}</span>
                <span class="spec-range-type">(${item.rangeType})</span>
                <span class="spec-price">mulai dari ${item.price}</span>
              </div>
            `).join('')}
          </div>
          <div class="price-container">
            <p class="price">${selectedItem.price}</p>
            <p class="price-otr">OTR Jakarta (IDR)</p>
            <p class="price-per">Harga per ${selectedItem.pricePer}</p>
          </div>
          <div class="specification-list">
            ${renderSpecification('Torsi Maksimum', selectedItem.specifications.maxTorque)}
            ${renderSpecification('Daya Maksimum', selectedItem.specifications.maxPower)}
            ${renderSpecification('Jarak Mengemudi NEDC', selectedItem.specifications.drivingRangeNedc)}
            ${renderSpecification('Kapasitas Baterai', selectedItem.specifications.batteryCapacity)}
            ${renderSpecification(acceleration, accelerationNumber)}
          </div>
        </div>
      `;
      container.innerHTML += itemHTML;
    });

    // Attach click events to spec buttons
    container.querySelectorAll('.spec-button').forEach(btn => {
      btn.addEventListener('click', function() {
        const carName = this.getAttribute('data-name');
        const specIndex = parseInt(this.getAttribute('data-index'), 10);
        selectedSpecs[carName] = specIndex;
        renderPricelist();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderPricelist);
  } else {
    renderPricelist();
  }
