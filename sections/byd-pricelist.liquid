{% schema %}
{
  "name": "BYD Pricelist",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Judul Halaman",
      "default": "Daftar Harga"
    }
  ],
  "presets": [
    {
      "name": "BYD Pricelist"
    }
  ]
}
{% endschema %}
