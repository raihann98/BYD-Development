{% comment %}
  BYD Pricelist Section
  Online Store 2.0 section for BYD Indonesia Pricelist (Daftar Harga)
{% endcomment %}

<style>
  .byd-pricelist-section {
    width: 100%;
    background-color: #ffffff;
    font-family: Montserrat, Arial, "Helvetica Neue", Helvetica, sans-serif !important;
    color: #111827;
  }

  .pricelist-container-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 20px 5rem;
    box-sizing: border-box;
  }

  .pricelist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .pricelist-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .pricelist-divider {
    width: 100%;
    height: 1px;
    background-color: #e5e7eb;
    border: none;
    margin: 0 0 2.5rem;
  }

  .pricelist-container {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 40px;
    row-gap: 60px;
  }

  @media (min-width: 640px) {
    .pricelist-container {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
      row-gap: 60px;
    }
  }

  @media (min-width: 991px) {
    .pricelist-container {
      column-gap: 50px;
      row-gap: 70px;
    }
  }

  .pricelist-item {
    display: flex;
    flex-direction: column;
    text-align: center;
    box-sizing: border-box;
  }

  .pricelist-item-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pricelist-item-link:hover .car-img {
    transform: scale(1.02);
  }

  .car-img-wrapper {
    width: 100%;
    height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .car-img {
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    transition: transform 0.35s ease;
    display: block;
    margin: 0 auto;
  }

  .logo-img-wrapper {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .logo-img {
    max-height: 32px;
    max-width: 220px;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .specs-container {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    min-height: 64px;
  }

  .spec-button {
    cursor: pointer;
    padding: 8px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #ffffff;
    transition: all 0.2s ease;
    text-align: center;
    min-width: 125px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    user-select: none;
  }

  .spec-button:hover:not(.active) {
    border-color: #9ca3af;
    background-color: #f9fafb;
  }

  .spec-button.active {
    border-color: #007bff;
    background-color: #ffffff;
    box-shadow: 0 0 0 1px #007bff;
  }

  .spec-type {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #111827;
    line-height: 1.25;
  }

  .spec-range-type {
    font-size: 0.75rem;
    color: #374151;
    line-height: 1.2;
    margin-top: 1px;
  }

  .spec-price {
    font-size: 0.6875rem;
    color: #7a8080;
    line-height: 1.2;
    margin-top: 3px;
  }

  .price-container {
    border-bottom: 1px solid #75acd0;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .price {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 0.35rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .price-otr {
    font-size: 0.75rem;
    line-height: 1rem;
    color: #8e95a5;
    margin: 0 0 2px;
  }

  .price-per {
    font-size: 0.75rem;
    line-height: 1rem;
    color: #8e95a5;
    margin: 0;
  }

  .specification-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .specification {
    text-align: center;
  }

  .specification-value {
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.025em;
    color: #111827;
    margin: 0 0 0.25rem;
  }

  .specification-name {
    font-size: 0.875rem;
    line-height: 1.25;
    color: #5c5e62;
    margin: 0;
  }

  @media (max-width: 639px) {
    .pricelist-container-wrapper {
      padding: 2rem 16px 3.5rem;
    }
    .pricelist-title {
      font-size: 1.875rem;
    }
    .car-img-wrapper {
      height: 200px;
    }
    .price {
      font-size: 1.5rem;
    }
    .specification-value {
      font-size: 1.35rem;
    }
  }
</style>

<div class="byd-pricelist-section">
  <div class="pricelist-container-wrapper">
    <div class="pricelist-header">
      <h1 class="pricelist-title">{{ section.settings.page_title | default: 'Daftar Harga' }}</h1>
    </div>
    <hr class="pricelist-divider">
    <div id="pricelist-container" class="pricelist-container">
      {% comment %}
        Interactive vehicle cards will be rendered dynamically by JavaScript
        and hydrated with exact reference specs & variant buttons.
      {% endcomment %}
    </div>
  </div>
</div>

