      "default": "Hingga 567km*"
    },
    {
      "type": "text",
      "id": "spec_1_lbl",
      "label": "Spesifikasi 1 Label",
      "default": "Jarak (NEDC)"
    },
    {
      "type": "text",
      "id": "spec_2_val",
      "label": "Spesifikasi 2 Nilai",
      "default": "82.56 kWh"
    },
    {
      "type": "text",
      "id": "spec_2_lbl",
      "label": "Spesifikasi 2 Label",
      "default": "Kapasitas Baterai"
    },
    {
      "type": "text",
      "id": "spec_3_val",
      "label": "Spesifikasi 3 Nilai",
      "default": "690 Nm*"
    },
    {
      "type": "text",
      "id": "spec_3_lbl",
      "label": "Spesifikasi 3 Label",
      "default": "Torsi Maksimum"
    },
    {
      "type": "text",
      "id": "spec_4_val",
      "label": "Spesifikasi 4 Nilai",
      "default": "AWD* (4.5s)"
    },
    {
      "type": "text",
      "id": "spec_4_lbl",
      "label": "Spesifikasi 4 Label",
      "default": "Penggerak & Akselerasi"
    },
    {
      "type": "text",
      "id": "label_test_drive",
      "label": "Label Tombol Uji Kendaraan",
      "default": "Uji Kendaraan"
    },
    {
      "type": "url",
      "id": "url_test_drive",
      "label": "Link Uji Kendaraan"
